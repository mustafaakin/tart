# Builds the UEFI drivers and embeds them, together with the Windows setup files, into
# Sources/tart/Windows/WindowsResources.swift. Needs clang and lld-link (brew install lld).

LLD_LINK ?= lld-link
CFLAGS = -target aarch64-unknown-windows -ffreestanding -fshort-wchar -fno-builtin -fno-stack-protector \
	-mno-implicit-float -O2 -Wall -Wextra -Wno-unused-parameter

OUTPUT = ../../Sources/tart/Windows/WindowsResources.swift

# media path:source file
EFI_SYSTEM_PARTITION = EFI/BOOT/BOOTAA64.EFI:loader.efi EFI/tart/framebuffer.efi:framebuffer.efi
DATA_PARTITION = autounattend.xml:autounattend.xml tart/install.cmd:install.cmd \
	tart/SetupComplete.cmd:SetupComplete.cmd tart/framebuffer.efi:framebuffer.efi tart/extend-c.ps1:extend-c.ps1

all: $(OUTPUT)

%.efi: %.c efi.h
	clang $(CFLAGS) -c $< -o $*.o
	$(LLD_LINK) /nologo /Brepro /nodefaultlib /dll /entry:efi_main /subsystem:$(SUBSYSTEM) /out:$@ $*.o
	rm -f $*.o $*.lib

framebuffer.efi: SUBSYSTEM = efi_boot_service_driver
loader.efi: SUBSYSTEM = efi_application

# Files are embedded as-is: the .cmd files are kept with the CRLF line endings cmd.exe expects
define embed
	@printf '    "%s": "%s",\n' "$(firstword $(subst :, ,$(1)))" "$$(base64 -i $(lastword $(subst :, ,$(1))))" >> $@

endef

$(OUTPUT): framebuffer.efi loader.efi $(foreach entry,$(DATA_PARTITION),$(lastword $(subst :, ,$(entry)))) Makefile
	@echo '// Generated by Resources/Windows/Makefile, do not edit.' > $@
	@echo '' >> $@
	@echo 'enum WindowsResources {' >> $@
	@echo '  // Relative path on the installation media to base64-encoded contents' >> $@
	@echo '  static let efiSystemPartition: [String: String] = [' >> $@
	$(foreach entry,$(EFI_SYSTEM_PARTITION),$(call embed,$(entry)))
	@echo '  ]' >> $@
	@echo '' >> $@
	@echo '  static let dataPartition: [String: String] = [' >> $@
	$(foreach entry,$(DATA_PARTITION),$(call embed,$(entry)))
	@echo '  ]' >> $@
	@echo '}' >> $@

clean:
	rm -f *.efi *.o *.lib

.PHONY: all clean
